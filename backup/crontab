# At the Kita's local time (TZ), outside 02:00-03:00, which the change to summer time skips once
# a year. Output goes to the container's log (docker compose logs backup); failures are also
# reported like crashes (see run-job).
30 1 * * * run-job nightly > /proc/1/fd/1 2>&1
0 4 * * 0 run-job weekly > /proc/1/fd/1 2>&1

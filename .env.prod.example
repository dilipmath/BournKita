# Settings for the production stack (compose.prod.yaml). Copy to .env beside it, fill in, and
# keep it readable by root only: it holds the keys to the Kita's data.

# The name the tablets open, e.g. kita.home.arpa (not a .local name: tablets look those up their
# own way, past the router); the router's DNS must give the server's address for it.
KITA_HOSTNAME=kita.home.arpa

# Long and random, e.g. `openssl rand -base64 32`.
KITA_DB_PASSWORD=

# Encrypts addresses, contact and health data and the photos. Replace "pending" with one made
# once (the app does not start without a real one):
#   docker compose -f compose.prod.yaml run --rm --no-deps api kita-admin generate-key
# Keep a copy apart from the backups (e.g. printed, in the safe): without it no backup can be
# read, and with it and a backup anyone can.
KITA_ENCRYPTION_KEY=pending

# The second drive, for the nightly backups (database and photos), e.g. /mnt/backup/kita.
KITA_BACKUP_DIR=
# Where the weekly encrypted backup is written to leave the building, e.g. a USB drive swapped
# each week and taken home: /mnt/offsite/kita.
KITA_OFFSITE_DIR=
# The age public key the weekly backup is encrypted to (age1…). Replace "pending" with the
# public key of a key pair made once (the backup service does not start without one):
#   docker compose -f compose.prod.yaml run --rm --no-deps backup age-keygen
# and keep the private key (AGE-SECRET-KEY-…) away from the server, e.g. printed, in the safe.
KITA_BACKUP_AGE_RECIPIENT=pending
# How many backups are kept; deleted and purged data stays in them until they go.
KITA_BACKUP_KEEP_NIGHTLY=14
KITA_BACKUP_KEEP_WEEKLY=8

# How long deleted Child profiles stay in the archive (set by the data-protection assessment).
KITA_ARCHIVE_RETENTION_MONTHS=12

# Email: unset KITA_SMTP_HOST only writes emails to the api log.
KITA_SMTP_HOST=
KITA_SMTP_PORT=587
KITA_SMTP_SECURITY=starttls
KITA_SMTP_USERNAME=
KITA_SMTP_PASSWORD=
KITA_MAIL_FROM=Kita Kids Database <kita@kita.home.arpa>
KITA_CRASH_REPORT_EMAIL=
KITA_FEEDBACK_EMAIL=

:80 {
	# Links carry tokens (e.g. email verification); never pass the address on to other sites.
	header Referrer-Policy no-referrer
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		# Hashed bundles never change; everything else must be revalidated so tablets pick up updates.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@revalidate not path /assets/*
		header @revalidate Cache-Control "no-cache"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

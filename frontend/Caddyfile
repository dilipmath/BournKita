:80 {
	# Links carry tokens (e.g. email verification); never pass the address on to other sites.
	header Referrer-Policy no-referrer
	handle /api/* {
		# Above the API's largest upload (a 20 MB photo), so nobody can fill the server's disk:
		# the API only sees a body's size once it has received all of it.
		request_body {
			max_size 25MB
		}
		reverse_proxy api:8000
	}
	handle {
		# Hashed bundles never change; everything else must be revalidated so tablets pick up updates.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@revalidate not path /assets/*
		header @revalidate Cache-Control "no-cache"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

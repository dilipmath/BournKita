# Production: HTTPS for the Kita's own host name (KITA_HOSTNAME, e.g. kita.home.arpa), with a
# certificate from Caddy's own certificate authority: the app is only reached inside the Kita's
# network, where no public authority can vouch for it. Tablets trust that authority once its root
# certificate is installed (see the README). HTTP requests are redirected to HTTPS.
{
	local_certs
	# Its root certificate is installed on the tablets, not in this container.
	skip_install_trust
}

{$KITA_HOSTNAME} {
	tls internal
	# Browsers that have seen HTTPS here never fall back to HTTP.
	header Strict-Transport-Security "max-age=31536000"
	import app.caddy
}

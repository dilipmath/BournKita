# What the web server does, with HTTP (Caddyfile, development) or HTTPS (Caddyfile.prod).
# Links carry tokens (e.g. email verification); never pass the address on to other sites.
header Referrer-Policy no-referrer
# Browsers take every answer as the type it says it is, and never show the app inside another
# site's frame (where clicks could be stolen).
header X-Content-Type-Options nosniff
header X-Frame-Options DENY
# Only the backup service inside the stack reports its failures (straight to the API).
handle /api/crash-reports/backups {
	respond 404
}
handle /api/* {
	# Above the API's largest upload (a 20 MB photo), so nobody can fill the server's disk:
	# the API only sees a body's size once it has received all of it.
	request_body {
		max_size 25MB
	}
	# Where the request came from, for the API's limits per address (e.g. failed logins).
	# Overwrites any such header a client sends, so nobody can pretend to be another tablet.
	reverse_proxy api:8000 {
		header_up X-Kita-Client-Address {remote_host}
	}
}
handle {
	# The app runs only its own files (no inline scripts or styles, nothing from elsewhere), so
	# injected markup could not run anything.
	header Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	# Hashed bundles never change; everything else must be revalidated so tablets pick up updates.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@revalidate not path /assets/*
	header @revalidate Cache-Control "no-cache"
	root * /srv
	try_files {path} /index.html
	file_server
}
